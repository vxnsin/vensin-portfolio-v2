# ---- admin panel (/admin) ----
# required to enable the admin panel. pick something long.
ADMIN_PASSWORD=
# optional: separate secret for signing the session cookie (defaults to the password)
ADMIN_SECRET=

# extra hosts allowed to submit forms (server actions), comma separated, e.g. 192.168.178.67:3000
SERVER_ACTIONS_ORIGINS=

# ---- legal ----
# the impressum is hosted by an external impressum service; /impressum and the footer forward to this url
IMPRESSUM_URL=

# ---- storage ----
# everything lives in one sqlite file: DATA_DIR/vensin.sqlite (default ./.data). fine on a raspberry pi.
# on vercel this is /tmp and NOT persistent.
DATA_DIR=
# gallery files go to UPLOAD_DIR (default ./public/uploads) unless a vercel blob token is set
UPLOAD_DIR=
BLOB_READ_WRITE_TOKEN=

# ---- background jobs ----
# the in-process scheduler refreshes github / discord / weather / anime data. set to "off" to disable.
SCHEDULER=

# ---- contact form → discord ----
# option A (DM): a bot token from https://discord.com/developers; the bot must share a server with you.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=531896089096486922
# option B (channel): a webhook url of a private channel. Used when no bot token is set.
DISCORD_WEBHOOK_URL=
# buttons on the notification cards (guestbook approve/reject, mark message read): the app's public key from the developer portal.
# also set the interactions endpoint url there to https://<your host>/api/discord/interactions
DISCORD_PUBLIC_KEY=
# guestbook entries that pass every filter go to this channel (bot channel id or a webhook) instead of your dms;
# flagged ones (links, spam words, very long) always come as a dm with approve/reject buttons
DISCORD_GUESTBOOK_CHANNEL_ID=
DISCORD_GUESTBOOK_WEBHOOK_URL=
# "new activity seen" cards (a premid site the discord widget has no handler for yet) go here instead of your dms
DISCORD_ACTIVITY_CHANNEL_ID=
DISCORD_ACTIVITY_WEBHOOK_URL=
# blocked-attempt cards carry a plain ip; they are deleted from discord again after this many days (default 14)
BLOCKED_RETENTION_DAYS=14
# ---- nightly database backup ----
# a private channel the bot can post in, or a webhook of that channel. The gzipped sqlite file lands there every night at 03:30.
DISCORD_BACKUP_CHANNEL_ID=
DISCORD_BACKUP_WEBHOOK_URL=
# how many local copies to keep in <DATA_DIR>/backups (default 14)
BACKUP_KEEP=14
# off-site copy: "discord" attaches the file to the channel message; "catbox" encrypts it (aes-256-gcm with BACKUP_PASSPHRASE),
# uploads it to catbox.moe and posts only the link. catbox is refused without a passphrase because its links are public.
BACKUP_UPLOAD=discord
BACKUP_PASSPHRASE=
# optional: your catbox account hash so the files show up in your catbox file manager
CATBOX_USERHASH=

# ---- weather widget ----
# rough coordinates, server-side only, never sent to the browser. Leave empty to disable.
WEATHER_LAT=
WEATHER_LON=

# ---- apple watch rings (POST /api/health from an iOS shortcut, see README) ----
HEALTH_TOKEN=
HEALTH_MOVE_GOAL=500
HEALTH_EXERCISE_GOAL=30
HEALTH_STAND_GOAL=12

# ---- spotify (music page) ----
# app from https://developer.spotify.com/dashboard; redirect uris: http://127.0.0.1:3000/api/spotify/callback and https://vensin.dev/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# host the redirect uri is built from; must match the spotify app exactly. default: https://vensin.dev in production, http://127.0.0.1:3000 in dev
SPOTIFY_REDIRECT_BASE=
