# ---- admin panel (/admin) ----
# required to enable the admin panel. pick something long.
ADMIN_PASSWORD=
# optional: separate secret for signing the session cookie (defaults to the password)
ADMIN_SECRET=

# ---- storage ----
# everything lives in one sqlite file: DATA_DIR/vensin.sqlite (default ./.data). fine on a raspberry pi.
# on vercel this is /tmp and NOT persistent.
DATA_DIR=
# gallery files go to UPLOAD_DIR (default ./public/uploads) unless a vercel blob token is set
UPLOAD_DIR=
BLOB_READ_WRITE_TOKEN=

# ---- background jobs ----
# the in-process scheduler refreshes github / discord / weather / anime data. set to "off" to disable.
SCHEDULER=

# ---- contact form → discord ----
# option A (DM): a bot token from https://discord.com/developers; the bot must share a server with you.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=531896089096486922
# option B (channel): a webhook url of a private channel. Used when no bot token is set.
DISCORD_WEBHOOK_URL=

# ---- weather widget ----
# rough coordinates, server-side only, never sent to the browser. Leave empty to disable.
WEATHER_LAT=
WEATHER_LON=

# ---- apple watch rings (POST /api/health from an iOS shortcut, see README) ----
HEALTH_TOKEN=
HEALTH_MOVE_GOAL=500
HEALTH_EXERCISE_GOAL=30
HEALTH_STAND_GOAL=12
